# Copy to the real settings file in this directory: `cp env.example .env`
# No secrets here.

# Public domain served by Caddy (automatic HTTPS). Use `localhost` for a local test.
PARAPKA_DOMAIN=example.duckdns.org

# Origins allowed to call the relay. Must match the address of the web app.
RELAY_ALLOWED_ORIGINS=https://${PARAPKA_DOMAIN}
